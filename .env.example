# Copy to .env for local work. On Vercel set these under Project Settings, Environment Variables.

# Shopify app (Dev Dashboard, your app, Settings)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_orders,read_customers,read_fulfillments,write_pixels,read_customer_events
# Optional: Vercel's production URL is used when this is empty
SHOPIFY_APP_URL=

# Supabase Postgres. Runtime uses the transaction pooler (port 6543), migrations the direct URL (port 5432)
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Any long random string. Encrypts courier and Meta secrets at rest. Never change it after the first store connects.
ENCRYPTION_KEY=
# Vercel sends this as "Authorization: Bearer ..." to the hourly cron
CRON_SECRET=
# Optional, defaults to SHOPIFY_API_SECRET: signs the checkout pixel posts
PIXEL_SECRET=

# Better Sales system user token (Business Settings, System users) with ads_read and ads_management.
# Used for every store that has no token of its own.
META_SYSTEM_USER_TOKEN=
# Meta app secret: used for Meta login, and adds appsecret_proof to Marketing API calls
META_APP_SECRET=
META_GRAPH_VERSION=v26.0

# Optional: Meta login for brands (Continue with Meta). Create a Meta app of type Business,
# add Facebook Login for Business, and set the redirect URI to <app url>/meta/oauth/callback
META_APP_ID=
